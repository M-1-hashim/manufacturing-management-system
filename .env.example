# ============================================================
# ManufacturingERP — نمونهٔ متغیرهای محیطی برای استقرار Vercel
# این فایل را کپی نکنید — فقط مقادیر را در پنل Vercel وارد کنید:
#   Vercel → پروژه → Settings → Environment Variables
# ============================================================

# ---------- دیتابیس MySQL (الزامی) ----------
# آدرس دیتابیس MySQL. روی Vercel فقط MySQL پشتیبانی می‌شود (SQLite ممکن نیست).
# نمونهٔ هاست اشتراکی (cPanel) — ابتدا در cPanel → Remote MySQL هاست % را مجاز کنید:
DATABASE_URL="mysql://USERNAME_mfguser:STRONG_PASSWORD@localhost:3306/USERNAME_mfgdb?connection_limit=5&connect_timeout=10"
# نمونهٔ سرویس ابری (Aiven / TiDB / Railway و…):
# DATABASE_URL="mysql://avnadmin:PASSWORD@mysql-xxxx.a.aivencloud.com:3306/defaultdb?ssl-mode=REQUIRED&connection_limit=5"

# ---------- کلید امضای نشست (برای استقرار واقعی الزامی) ----------
# رشتهٔ تصادفی حداقل ۳۲ کاراکتری — ساخت با: openssl rand -base64 48
SESSION_SECRET=""

# ---------- حالت دمو بدون دیتابیس (اختیاری) ----------
# اگر DATABASE_URL تنظیم نشده باشد، برنامه به‌طور خودکار در «حالت نمایشی»
# بالا می‌آید: لاگین ساده admin/admin123 + دیتای نمونه در مرورگر هر بازدیدکننده.
# برای تغییر حساب دمو این دو را تنظیم کنید (در زمان بیلد اعمال می‌شوند):
# NEXT_PUBLIC_DEMO_USERNAME="demo"
# NEXT_PUBLIC_DEMO_PASSWORD="رمز-دلخواه"
# برای خاموش‌کردن رفتار خودکار دمو:
# NEXT_PUBLIC_DEMO_MODE=0

# ---------- اختیاری ----------
# نسخهٔ Node روی Vercel (۲۰ یا ۲۲)
# NODE_VERSION=22
